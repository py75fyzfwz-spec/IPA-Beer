# Teacher mode (/teacher). Set these in Vercel → Project → Settings →
# Environment Variables, or in .env.local for `npm run dev`.

# The passcode the teacher types to open teacher mode.
TEACHER_PASSCODE=

# Supabase → Project Settings → API (or "API Keys").
SUPABASE_URL=https://your-project.supabase.co
# The secret key (sb_secret_…) or the legacy service_role key. Server only:
# never prefix it with NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=
